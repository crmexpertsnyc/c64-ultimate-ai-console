# ---------------------------------------------------------------------------
# C64 Ultimate AI Console — copy to .env and edit.
# Everything here can also be set in the web UI (Settings / Setup Wizard);
# UI changes are stored in DATA_DIR/settings.json and take precedence.
# ---------------------------------------------------------------------------

# --- C64 Ultimate ---------------------------------------------------------
C64_ULTIMATE_HOST=192.168.1.64
C64_ULTIMATE_PORT=80
C64_ULTIMATE_PROTOCOL=http
# Only if a network password is set on the Ultimate (sent as X-Password; never logged)
C64_ULTIMATE_PASSWORD=
# Delay between key taps when typing through the REST input API (ms)
C64_TYPE_DELAY_MS=60
# How PRG/CRT/disk uploads are sent: raw (default) or multipart
C64_UPLOAD_MODE=raw

# --- Simulation (no hardware needed) ---------------------------------------
SIMULATE_C64=false
# modern = firmware with machine:input + menu_screen; legacy = Commodore 1.1.0 / Spiffy style
SIMULATE_PROFILE=modern

# --- Web app ----------------------------------------------------------------
WEB_PORT=8064
DATA_DIR=./data
# Leave empty for SQLite in DATA_DIR. PostgreSQL later: postgresql+psycopg://user:pass@host/db
DATABASE_URL=
# Library folders, separated by ";" (inside Docker use the container paths, e.g. /games)
LIBRARY_PATHS=
# Host folder mounted read-only at /games by docker-compose
LIBRARY_HOST_PATH=./games
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ALLOW_POWER_OFF=true

# --- AI (optional; the app works fully without it) --------------------------
# none | vllm | ollama | openwebui | openai | anthropic
AI_PROVIDER=none
# vLLM on a DGX Spark:  AI_PROVIDER=vllm   AI_BASE_URL=http://dgx-spark:8000/v1   AI_MODEL=<served model name>
# Ollama:               AI_PROVIDER=ollama AI_BASE_URL=http://localhost:11434    AI_MODEL=llama3.1:8b
# OpenWebUI:            AI_PROVIDER=openwebui AI_BASE_URL=http://host:3000/api   AI_MODEL=<model id>  AI_API_KEY=<key>
# Anthropic:            AI_PROVIDER=anthropic AI_MODEL=claude-sonnet-5          AI_API_KEY=<key>
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=60
AI_MAX_TOKENS=1500
# low / medium / high for reasoning models such as gpt-oss (blank = not sent)
AI_REASONING_EFFORT=low

# --- Streams ----------------------------------------------------------------
# IP the Ultimate should send UDP video/audio to (this machine). Auto-detected when empty.
# In Docker (bridge networking) set this to the Docker HOST's LAN IP.
STREAM_TARGET_HOST=
STREAM_VIDEO_PORT=11000
STREAM_AUDIO_PORT=11001

# --- AI vision mode (experimental, off by default) --------------------------
VISION_ENABLED=false
VISION_MAX_ACTIONS_PER_SECOND=2
VISION_MAX_SESSION_SECONDS=120
VISION_MAX_ACTIONS_PER_SESSION=200

# --- Assembly64 online catalog -------------------------------------------------
# Used for "Play <title>" when a title is not in your local library, and on the Catalog page.
# The public service only accepts registered client ids (HTTP 464 otherwise). Spiffy firmware
# sends "Spiffy" for this same catalog; set whatever id you are entitled to use.
ASSEMBLY64_URL=https://hackerswithstyle.se
ASSEMBLY64_CLIENT_ID=

# --- MCP (AI agents) ----------------------------------------------------------
# Built-in endpoint: http://<host>:8064/mcp  (docs/mcp.md, or Settings -> Connect AI agents)
MCP_ENABLED=true
# Without a token only this computer may connect. Set one to allow other machines.
MCP_TOKEN=
# Extra hosts allowed WITHOUT a token (comma separated), e.g. spark-2d40
MCP_ALLOWED_HOSTS=
# Where the stdio launcher (backend/c64_mcp.py) finds the console
MCP_API_BASE=http://127.0.0.1:8064
